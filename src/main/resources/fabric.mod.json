{
	"schemaVersion": 1,
	"id": "urc",
	"version": "${version}",
	"name": "URC",
	"description": "A Carpet Mod extension: combat tweaks, custom-shaped nether portals, anvil / villager / iron farm QoL and more, all toggleable through /carpet rules.",
	"authors": [
		"URC"
	],
	"contact": {
		"homepage": "https://github.com/Landon-Dion/carpet-urc",
		"sources": "https://github.com/Landon-Dion/carpet-urc"
	},
	"license": "MIT",
	"icon": "assets/urc/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.urc.URC"
		]
	},
	"mixins": [
		"urc.mixins.json",
		{
			"config": "${client_mixin_config}",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${mc_dep}",
		"java": ">=25",
		"carpet": ">=26.1"
	}
}
